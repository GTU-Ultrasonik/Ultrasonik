# M3 module-local ignores (the repository .gitignore already covers .pio/, *.log, lib/, ...)

# generated by tests/run_all.py and standins/hil/hil_sim.py; curated copies go to reports/<run>/
reports/generated/

# personal settings: copy config/hil_config.example.json, set your COM ports and board IP
config/hil_config.json
# Wi-Fi name and password for the board (see src/firmware/m3_config.h)
src/firmware/wifi_secrets.h

# virtual board and tuner binaries built by hand
/vboard
/vboard.exe
/tune
/tune.exe
